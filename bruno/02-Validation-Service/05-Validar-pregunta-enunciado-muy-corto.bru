meta {
  name: 05 - Validar pregunta con enunciado menor a 10 caracteres
  type: http
  seq: 5
}

post {
  url: {{validationUrl}}/api/validaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enunciado": "Corto",
    "opciones": [
      { "texto": "Opción 1", "correcta": true },
      { "texto": "Opción 2", "correcta": false }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.valido: eq false
}
